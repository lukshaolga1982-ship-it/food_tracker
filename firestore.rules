rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == "admin";
    }

    function isFood() {
      return signedIn() && userData().role == "food";
    }

    function isTeacher() {
      return signedIn() && userData().role == "teacher";
    }

    function teacherHasClass(classId) {
      return isTeacher() && classId in userData().classIds;
    }

    // Время в Firebase request.time — UTC. Для Браслава используем UTC+3.
    // Поэтому все проверки дедлайна делаем относительно Минска/Браслава,
    // а не относительно часового пояса браузера пользователя.
    function nowMinsk() {
      return request.time + duration.value(3, 'h');
    }

    function teacherCanEditOwnMealDate(data) {
      let now = nowMinsk();
      return isTeacher()
        && data.userId == request.auth.uid
        && (
          (data.year == now.year()
            && data.month == now.month()
            && data.day == now.day()
            && now.hours() < 9)
          ||
          ((data.year > now.year()
            || (data.year == now.year() && data.month > now.month())
            || (data.year == now.year() && data.month == now.month() && data.day > now.day()))
            && now.hours() >= 10)
        );
    }

    function teacherCanEditDate(data) {
      let now = nowMinsk();
      return teacherHasClass(data.classId)
        && (
          // Текущий день: до 09:00 по Браславу.
          (data.year == now.year()
            && data.month == now.month()
            && data.day == now.day()
            && now.hours() < 9)
          ||
          // Будущие дни: с 10:00 по Браславу.
          (
            (data.year > now.year()
              || (data.year == now.year() && data.month > now.month())
              || (data.year == now.year() && data.month == now.month() && data.day > now.day()))
            && now.hours() >= 10
          )
        );
    }

    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin() || isFood());

      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "teacher"
          && request.resource.data.classIds.size() == 0);

      allow update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && teacherHasClass(resource.data.classId));

      allow create: if isAdmin()
        || (isTeacher() && teacherHasClass(request.resource.data.classId));

      allow update: if isAdmin()
        || (isTeacher()
          && teacherHasClass(resource.data.classId)
          && request.resource.data.classId == resource.data.classId);

      allow delete: if isAdmin();
    }

    match /dailyRecords/{recordId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && teacherHasClass(resource.data.classId));

      allow create: if isAdmin()
        || (isTeacher() && teacherCanEditDate(request.resource.data));

      allow update: if isAdmin()
        || (isTeacher()
          && teacherCanEditDate(resource.data)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.dateKey == resource.data.dateKey);

      allow delete: if isAdmin();
    }

    match /dailySubmissions/{submissionId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && teacherHasClass(resource.data.classId));

      allow create: if isAdmin()
        || (isTeacher() && teacherCanEditDate(request.resource.data));

      allow update: if isAdmin()
        || (isTeacher()
          && teacherCanEditDate(resource.data)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.dateKey == resource.data.dateKey);

      allow delete: if isAdmin();
    }

    match /teacherMeals/{mealId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && resource.data.userId == request.auth.uid);

      allow create: if teacherCanEditOwnMealDate(request.resource.data)
        && request.resource.data.status in ["eating", "not_eating"];

      allow update: if teacherCanEditOwnMealDate(resource.data)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ["eating", "not_eating"];

      allow delete: if isAdmin();
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
