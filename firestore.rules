rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userData().role == "admin";
    }

    function isFood() {
      return signedIn() && userData().role == "food";
    }

    function isTeacher() {
      return signedIn() && userData().role == "teacher";
    }

    function teacherHasClass(classId) {
      return isTeacher() && classId in userData().classIds;
    }

    // Беларусь использует UTC+3.
    // Текущий день: редактирование до 09:00 по Минску (до 06:00 UTC).
    // Будущие дни: редактирование открывается после 10:00 по Минску (с 07:00 UTC).
    function teacherCanEditDate(data) {
      return teacherHasClass(data.classId)
        && (
          (data.year == request.time.year()
            && data.month == request.time.month()
            && data.day == request.time.day()
            && request.time.hours() < 6)
          ||
          (
            (data.year > request.time.year()
              || (data.year == request.time.year() && data.month > request.time.month())
              || (data.year == request.time.year() && data.month == request.time.month() && data.day > request.time.day()))
            && request.time.hours() >= 7
          )
        );
    }

    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin() || isFood());

      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "teacher"
          && request.resource.data.classIds.size() == 0);

      allow update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && teacherHasClass(resource.data.classId));

      allow create: if isAdmin()
        || (isTeacher() && teacherHasClass(request.resource.data.classId));

      allow update: if isAdmin()
        || (isTeacher()
          && teacherHasClass(resource.data.classId)
          && request.resource.data.classId == resource.data.classId);

      allow delete: if isAdmin();
    }

    match /dailyRecords/{recordId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && teacherHasClass(resource.data.classId));

      allow create: if isAdmin()
        || (isTeacher() && teacherCanEditDate(request.resource.data));

      allow update: if isAdmin()
        || (isTeacher()
          && teacherCanEditDate(resource.data)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.dateKey == resource.data.dateKey);

      allow delete: if isAdmin();
    }

    match /dailySubmissions/{submissionId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && teacherHasClass(resource.data.classId));

      allow create: if isAdmin()
        || (isTeacher() && teacherCanEditDate(request.resource.data));

      allow update: if isAdmin()
        || (isTeacher()
          && teacherCanEditDate(resource.data)
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.dateKey == resource.data.dateKey);

      allow delete: if isAdmin();
    }

    match /teacherMeals/{mealId} {
      allow read: if isAdmin() || isFood()
        || (isTeacher() && resource.data.userId == request.auth.uid);

      allow create: if isTeacher()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ["eating", "not_eating"];

      allow update: if isTeacher()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ["eating", "not_eating"];

      allow delete: if isAdmin();
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
